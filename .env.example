# Discord bot configuration
token=                  # Discord bot token
mongodb_uri=            # MongoDB connection string (bot.js / MONGODB mode)
postgres_uri=           # Postgres connection string (optional)

# Radio server
RadioAudioUrl=          # default radio stream URL

# Socket and dashboard
SOCKET_PORT=3030        # live-status Socket.io port (dashboard)
DASHBOARD_ORIGIN=*      # CORS origin for the dashboard socket

# Logging
ERROR_LOGS=             # Discord webhook URL for error logs
WARN_LOGS=              # Discord webhook URL for warn logs

# Test mode
testMode=               # set to any value to enable test mode

# Audio processing configuration
# By default, the bot embeds the audio broadcaster (AUDIO_MODE=embedded).
# Set AUDIO_MODE=remote to run ffmpeg on a separate audio-server.js process instead.
# Remote mode is useful for multi-shard deployments where you want one ffmpeg per station
# per host, rather than one per shard, reducing CPU and memory overhead.

AUDIO_MODE=embedded              # embedded = broadcaster runs inside the bot (default, zero setup).
                                 # remote  = pull ready OGG/Opus from audio-server.js (no ffmpeg in the bot).
AUDIO_REMOTE_SHARDS=            # optional, remote mode only. Comma-separated shard ids that
                                 # should use the audio server; every other shard stays embedded.
                                 # Empty/unset = all shards go remote. Use it to roll out one
                                 # shard at a time (e.g. 0, then 0,1,2, then empty for all).
                                 # Ignored when AUDIO_MODE=embedded, and ignored on an unsharded
                                 # run (npm start / node index.js) where there is nothing to split.
AUDIO_SERVER_URL=http://127.0.0.1:3040   # where the bot pulls streams from (remote mode)
AUDIO_SERVER_PORT=3040           # port audio-server.js listens on (binds 127.0.0.1 only)
AUDIO_SERVER_TOKEN=change_me     # bearer token required on every audio server request — CHANGE THIS
AUDIO_BITRATE=128k               # ffmpeg -b:a for the Opus encode (embedded mode / audio server)
AUDIO_STATION_IDLE_MS=600000     # audio server keeps a station warm this long after its last client

# Statistics history (written ONLY by the manager process that runs liveSocket;
# shards send their events to it over the sharding IPC). Kept in its own SQLite
# file, never in the good.db JSON file the bot uses for live configuration.
STATS_DB_PATH=./database/stats.sqlite   # stats store location
STATS_RAW_RETENTION_DAYS=90             # how long raw events and 5-minute snapshots are kept
STATS_HOURLY_RETENTION_DAYS=365         # how long the hourly rollups are kept
STATS_SNAPSHOT_INTERVAL_MS=300000       # how often a snapshot is persisted (5 minutes)
STATS_CLEANUP_INTERVAL_MS=21600000      # how often rollup + pruning runs (6 hours)
